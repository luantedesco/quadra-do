<% content_for :page_title, @list.name %>
<div class="container-fluid">
  <button class="btn btn-light d-md-none mb-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#tasks-panel" aria-controls="tasks-panel" aria-label="<%= List.model_name.human(count: 2) %>">
    <i class="ri-menu-line"></i>
  </button>

  <%= render "tasks/quick_add", list: @list %>

  <div class="card mb-0">
    <div class="card-body" id="list-tasks">
      <% @tasks.each do |task| %>
        <%= render "lists/task_row", task: %>
      <% end %>
      <% if @tasks.empty? %>
        <p class="text-muted text-center mb-0"><%= t("lists.no_tasks") %></p>
      <% end %>
    </div>
  </div>

  <% if @finished_tasks.any? %>
    <div class="mt-3" id="finished-tasks">
      <h5 class="m-0 pb-2">
        <a class="text-body" data-bs-toggle="collapse" href="#finished-tasks-body" role="button" aria-expanded="false" aria-controls="finished-tasks-body">
          <i class="ri-arrow-down-s-line font-18"></i><%= t("lists.finished") %> <span class="text-muted">(<%= @finished_tasks.size %>)</span>
        </a>
      </h5>
      <div class="collapse" id="finished-tasks-body">
        <div class="card mb-0">
          <div class="card-body">
            <% @finished_tasks.each do |task| %>
              <%= render "lists/task_row", task: %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
