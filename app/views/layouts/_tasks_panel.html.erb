<div class="tasks-panel offcanvas-md offcanvas-start" tabindex="-1" id="tasks-panel" aria-labelledby="tasks-panel-title">
  <div class="d-flex align-items-center justify-content-between px-3 pt-3 pb-2">
    <h5 class="m-0 text-uppercase fs-6 text-muted" id="tasks-panel-title"><%= List.model_name.human(count: 2) %></h5>
    <div class="d-flex align-items-center gap-1">
      <%= link_to new_list_path, data: { turbo_frame: "modal" }, class: "btn btn-sm btn-light", title: t("lists.new"), aria: { label: t("lists.new") } do %>
        <i class="ri-add-line"></i>
      <% end %>
      <button type="button" class="btn-close d-md-none" data-bs-dismiss="offcanvas" data-bs-target="#tasks-panel" aria-label="Close"></button>
    </div>
  </div>
  <ul class="list-unstyled px-2 pb-3 m-0" id="tasks-panel-lists">
    <% Web::Queries::Lists::IndexQuery.new.call.each do |list| %>
      <li class="<%= class_names("tasks-panel-item d-flex align-items-center", active: @list&.persisted? && @list.id == list.id) %>">
        <%= link_to list_path(list), class: "flex-grow-1 text-truncate" do %>
          <%= tag.i(class: class_names("ri-circle-fill font-10 me-2", "text-muted": list.color.blank?), style: ("color: #{list.color};" if list.color.present?)) %>
          <%= list.name %>
        <% end %>
        <%= render "layouts/tasks_panel_menu", list: %>
      </li>
    <% end %>
  </ul>
</div>
