<!DOCTYPE html>
<html <%= document_attributes %>>
  <head>
    <title><%= [ page_title, "Quadra Do" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Quadra Do">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "favicon.svg", type: "image/svg+xml" %>
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Só o CSS compilado pelo dartsass: os .css de app/assets/stylesheets já entram nele por @import. %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="wrapper">
      <%= render "layouts/sidebar" %>
      <%= render "layouts/tasks_panel" if tasks_panel? %>
      <button class="btn btn-light sidebar-mobile-toggle d-md-none" data-action="sidebar#toggle" aria-label="<%= t("sidebar.menu") %>">
        <i class="ri-menu-line"></i>
      </button>
      <div class="<%= class_names("content-page", "with-tasks-panel": tasks_panel?) %>">
        <div class="content">
          <div class="container-fluid">
            <%= render "layouts/page_title" %>
          </div>
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
